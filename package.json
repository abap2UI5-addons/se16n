{
  "name": "abap2ui5-se16n",
  "private": true,
  "version": "1.0.0",
  "description": "SE16N-like data browser in your browser, built with abap2UI5.",
  "scripts": {
    "rename": "abaplint .github/abaplint/rename.json --rename",
    "lint": "abaplint ./abaplint.jsonc",
    "check:cloud": "abaplint .github/abaplint/abap_cloud.jsonc",
    "check:abap2ui5": "abap2ui5lint",
    "check": "npm run lint && npm run check:cloud && npm run check:abap2ui5 && npm run rename",
    "test": "npm run check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abap2UI5-addons/se16n.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/abap2UI5-addons/se16n/issues"
  },
  "homepage": "https://github.com/abap2UI5-addons/se16n#readme",
  "devDependencies": {
    "@abaplint/cli": "^2.120.50",
    "@abap2ui5/linter": "^0.6.1",
    "@abap2ui5/render-runtime": "^0.6.1"
  },
  "engines": {
    "node": ">=22"
  }
}
